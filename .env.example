# PINAKA Frontend Environment Configuration
# Development default: http://localhost:8000
# Production: Set to your deployed backend URL on Render (e.g. https://pinaka-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# Production WebSocket URL (e.g. wss://pinaka-backend.onrender.com/ws/live)
VITE_WS_URL=ws://localhost:8000/ws/live
