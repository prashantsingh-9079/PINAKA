# PINAKA Backend Environment Variables
# Copy this file to .env and fill in the values

# API Settings
API_V1_STR=/api
PROJECT_NAME=PINAKA

# CORS Settings
BACKEND_CORS_ORIGINS=["*"]

# Gemma Flash Settings (for text processing tasks)
GEMMA_MODEL_NAME=google/gemma-2-2b-it
# For Hugging Face models, you need an access token if the model is private
# Get your token from https://huggingface.co/settings/tokens
GEMMA_API_KEY=your_huggingface_access_token_here
GEMMA_MAX_LENGTH=512
GEMMA_TEMPERATURE=0.7

# Database (if needed)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Redis (for caching/queues)
REDIS_URL=redis://localhost:6379

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB

# Ingestion settings
INGESTION_BUFFER_SIZE=1000
INGESTION_WORKERS=4

# Tracking settings
MAX_TRACKING_OBJECTS=100
TRACKING_IOU_THRESHOLD=0.5

# Event detection
EVENT_CONFIDENCE_THRESHOLD=0.7
EVENT_MIN_DURATION=1.0  # seconds

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True