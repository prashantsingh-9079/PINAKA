# PINAKA Backend Environment Configuration
PROJECT_NAME=PINAKA
VERSION=2.4.0
API_PREFIX=/api

# Database: SQLite for local dev, PostgreSQL for production on Render
# Local: sqlite:///./pinaka.db
# Render: postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./pinaka.db

# CORS Allowed Origins (Comma-separated or list)
CORS_ORIGINS=["http://localhost:5645","http://localhost:5173","https://*.vercel.app","*"]

# Simulation Engine Tick Rate (Hz)
SIMULATION_TICK_RATE_HZ=10
